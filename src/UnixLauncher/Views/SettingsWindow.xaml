<local:MacWindow x:Class="UnixLauncher.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UnixLauncher.Views"
        Title="Launcher Settings" Width="800" Height="600" MinWidth="640" MinHeight="420" ResizeMode="CanResize">
    <!-- Laid out like macOS System Settings: glass sidebar of categories, grouped rows on the right. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Border Background="Transparent" MouseLeftButtonDown="Drag">
            <DockPanel Margin="10,52,10,10">
                <Border DockPanel.Dock="Top" CornerRadius="6" Background="{StaticResource CardBg}" Padding="8,4" Margin="0,0,0,10">
                    <DockPanel>
                        <ContentControl x:Name="SearchIcon" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <Grid>
                            <TextBlock x:Name="SearchPlaceholder" Text="Search" Foreground="{StaticResource SubText}" Margin="2,0,0,0" IsHitTestVisible="False"/>
                            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" TextChanged="Search_Changed"/>
                        </Grid>
                    </DockPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Nav"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1" Background="{StaticResource ContentBg}">
            <Grid DockPanel.Dock="Top" Height="52" Background="Transparent" MouseLeftButtonDown="Drag">
                <TextBlock x:Name="PageTitle" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="22,0,0,0"/>
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Page" Margin="22,0,22,22"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</local:MacWindow>
