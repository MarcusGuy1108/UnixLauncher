<local:MacWindow x:Class="UnixLauncher.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UnixLauncher.Views"
        Title="Launcher Settings" Width="560" SizeToContent="Height">
    <local:MacWindow.Resources>
        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource SubText}"/>
            <Setter Property="Padding" Value="0,6,0,4"/>
        </Style>
    </local:MacWindow.Resources>

    <StackPanel>
        <TextBlock Text="Dock" Style="{StaticResource H}" Margin="0,0,0,6"/>
        <Label Content="Position on screen"/>
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="PosLeft" Content="Left" GroupName="pos" Checked="Changed"/>
            <RadioButton x:Name="PosBottom" Content="Bottom" GroupName="pos" Checked="Changed"/>
            <RadioButton x:Name="PosRight" Content="Right" GroupName="pos" Checked="Changed"/>
        </StackPanel>
        <Label Content="Size"/>
        <Slider x:Name="SizeSlider" Style="{StaticResource MacSlider}" Minimum="32" Maximum="96" ValueChanged="Changed"/>
        <CheckBox x:Name="MagnifyBox" Content="Magnification" Margin="0,10,0,4" Click="Changed"/>
        <Slider x:Name="MagnifySlider" Style="{StaticResource MacSlider}" Minimum="1.1" Maximum="2.5" ValueChanged="Changed"/>
        <CheckBox x:Name="AutoHideBox" Content="Automatically hide and show the Dock" Margin="0,10,0,4" Click="Changed"/>

        <TextBlock Text="Menu bar &amp; windows" Style="{StaticResource H}"/>
        <CheckBox x:Name="HideTaskbarBox" Content="Hide the Windows taskbar" Click="Changed"/>
        <CheckBox x:Name="OverlayBox" Content="Show red/yellow/green buttons on other apps' windows" Click="Changed"/>
        <Label Content="Leave these apps' title bars alone (exe names, comma separated, e.g. chrome.exe, msedge.exe)"/>
        <TextBox x:Name="ExcludeBox" TextChanged="Changed" Padding="4,3"/>
        <Label Content="Font family (San Francisco can't be bundled; type any installed font)"/>
        <TextBox x:Name="FontBox" TextChanged="Changed" Padding="4,3"/>

        <TextBlock Text="Startup" Style="{StaticResource H}"/>
        <CheckBox x:Name="StartupBox" Content="Start UnixLauncher when I sign in" Click="Startup_Click"/>
        <CheckBox x:Name="ShellBox" Content="Use UnixLauncher as my Windows shell instead of Explorer (from next sign-in)" Click="Shell_Click"/>
        <TextBlock x:Name="ModeText" Foreground="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,4,0,0"/>

        <TextBlock Text="Icons" Style="{StaticResource H}"/>
        <TextBlock Foreground="{StaticResource SubText}" TextWrapping="Wrap"
                   Text="Drop PNG or ICO files into the icons folder to replace any icon (logo, Launchpad, Recycle Bin, apps…). See README.md in that folder for the file names."/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Open Icons Folder" Style="{StaticResource FlatButton}" Click="OpenIcons_Click" Background="{StaticResource CardBg}"/>
            <Button Content="Reload Icons" Style="{StaticResource FlatButton}" Click="ReloadIcons_Click" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</local:MacWindow>
