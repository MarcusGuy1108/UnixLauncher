<local:MacWindow x:Class="UnixLauncher.Views.FinderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UnixLauncher.Views"
        Title="Finder" Width="1000" Height="640" MinWidth="560" MinHeight="360" ResizeMode="CanResize">
    <local:MacWindow.Resources>

        <ItemsPanelTemplate x:Key="IconPanel"><WrapPanel Margin="8"/></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ListPanel"><VirtualizingStackPanel/></ItemsPanelTemplate>

        <!-- Icon view: grey box behind the icon and a blue pill behind the name when selected, as in Finder -->
        <DataTemplate x:Key="IconItem">
            <StackPanel Width="100" Margin="2,6" Background="Transparent">
                <Border x:Name="Box" CornerRadius="6" Padding="4" HorizontalAlignment="Center">
                    <Image Source="{Binding Icon}" Width="64" Height="64"/>
                </Border>
                <Border x:Name="LabelBg" CornerRadius="4" Padding="4,1" HorizontalAlignment="Center" Margin="0,3,0,0">
                    <TextBlock Text="{Binding DisplayName}" FontSize="12" MaxWidth="92" MaxHeight="32" TextAlignment="Center"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                </Border>
                <TextBlock x:Name="InfoLine" Text="{Binding Info}" FontSize="10" Foreground="{StaticResource SubText}" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="96" Margin="0,2,0,0"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Info}" Value="{x:Null}">
                    <Setter TargetName="InfoLine" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Box" Property="Background" Value="#33FFFFFF"/>
                    <Setter TargetName="LabelBg" Property="Background" Value="{StaticResource Accent}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- List view row; column widths match ListHeader -->
        <DataTemplate x:Key="ListItem">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition Width="180"/><ColumnDefinition Width="90"/><ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <DockPanel>
                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <TextBlock Grid.Column="1" Text="{Binding DateText}" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Opacity="0.7"/>
                <TextBlock Grid.Column="3" Text="{Binding Kind}" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </DataTemplate>

        <Style x:Key="IconContainer" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowContainer" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="8,3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Zebra stripes, like Finder's list view -->
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#0BFFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource SubText}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>


        <Style x:Key="ViewToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="8,3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </local:MacWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: transparent, so the window's glass (or panel colour) shows through; starts below the traffic lights -->
        <Border Background="Transparent" MouseLeftButtonDown="DragArea_MouseDown">
            <ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="0,52,0,0">
                <StackPanel x:Name="Sidebar" Margin="10,0,10,10"/>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Column="1" Background="{StaticResource ContentBg}">
            <!-- Unified toolbar: drag the window from any empty part of it -->
            <Grid DockPanel.Dock="Top" Height="52" Background="Transparent" MouseLeftButtonDown="DragArea_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button x:Name="BackBtn" Style="{StaticResource FlatButton}" Click="Back_Click" ToolTip="Back (Alt+Left)"/>
                    <Button x:Name="ForwardBtn" Style="{StaticResource FlatButton}" Click="Forward_Click" ToolTip="Forward (Alt+Right)"/>
                    <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource Text}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Border CornerRadius="6" Background="{StaticResource CardBg}" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="IconsBtn" Style="{StaticResource ViewToggle}" Click="IconsView_Click" ToolTip="as Icons (Ctrl+1)"/>
                            <ToggleButton x:Name="ListBtn" Style="{StaticResource ViewToggle}" Click="ListView_Click" ToolTip="as List (Ctrl+2)"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="ActionBtn" Style="{StaticResource FlatButton}" Click="Action_Click" ToolTip="Actions" Margin="6,0,0,0"/>
                    <Border Width="200" CornerRadius="6" Background="{StaticResource CardBg}" Padding="8,3" Margin="6,0,0,0">
                        <DockPanel>
                            <ContentControl x:Name="SearchIcon" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <Grid>
                                <TextBlock x:Name="SearchPlaceholder" Text="Search" Foreground="{StaticResource SubText}" Margin="2,0,0,0" IsHitTestVisible="False"/>
                                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" TextChanged="Search_Changed"/>
                            </Grid>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Path bar and status bar (Finder: View › Show Path Bar / Status Bar) -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="10,3,10,4">
                <StackPanel>
                    <StackPanel x:Name="PathBar" Orientation="Horizontal" ClipToBounds="True"/>
                    <TextBlock x:Name="StatusText" HorizontalAlignment="Center" Foreground="{StaticResource SubText}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Grid x:Name="ListHeader" DockPanel.Dock="Top" Height="24" Margin="10,0,10,2" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition Width="180"/><ColumnDefinition Width="90"/><ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="NameHeader" Style="{StaticResource HeaderButton}" Tag="Name" Click="Header_Click"/>
                <Button x:Name="DateHeader" Grid.Column="1" Style="{StaticResource HeaderButton}" Tag="Date" Click="Header_Click"/>
                <Button x:Name="SizeHeader" Grid.Column="2" Style="{StaticResource HeaderButton}" Tag="Size" Click="Header_Click"/>
                <Button x:Name="KindHeader" Grid.Column="3" Style="{StaticResource HeaderButton}" Tag="Kind" Click="Header_Click"/>
            </Grid>

            <ListBox x:Name="Files" Background="Transparent" BorderThickness="0" Margin="10,0,10,4" SelectionMode="Extended"
                     AllowDrop="True" TextSearch.TextPath="DisplayName" AlternationCount="2"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                     MouseDoubleClick="Files_DoubleClick" MouseRightButtonUp="Files_RightClick" SelectionChanged="Files_SelectionChanged"
                     PreviewMouseLeftButtonDown="Files_PreviewMouseDown" PreviewMouseMove="Files_PreviewMouseMove"
                     DragOver="Files_DragOver" Drop="Files_Drop"/>
        </DockPanel>
    </Grid>
</local:MacWindow>
