<local:Popover x:Class="UnixLauncher.Views.NotificationCentre"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UnixLauncher.Views"
        Width="384" Height="700" Title="Notification Centre" Foreground="{StaticResource Text}" FontSize="13">
    <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="12" Margin="8">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="4,0,0,10">
                <Button DockPanel.Dock="Right" Content="Clear All" Style="{StaticResource FlatButton}" Click="ClearAll_Click"/>
                <TextBlock x:Name="DateText" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Widget area -->
            <Border DockPanel.Dock="Bottom" CornerRadius="12" ClipToBounds="True" Margin="0,10,0,0" Background="White">
                <Viewbox MaxHeight="230">
                    <Calendar BorderThickness="0" Foreground="Black"/>
                </Viewbox>
            </Border>

            <TextBlock x:Name="StatusText" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{StaticResource SubText}" Margin="4,0,4,8"/>

            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBg}" CornerRadius="12" Padding="12,8,8,12" Margin="0,0,0,8">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top">
                                        <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource FlatButton}" Padding="6,0" Tag="{Binding}" Click="Dismiss_Click" ToolTip="Dismiss"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Foreground="{StaticResource SubText}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding App}" Foreground="{StaticResource SubText}" FontSize="11" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding Body}" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</local:Popover>
