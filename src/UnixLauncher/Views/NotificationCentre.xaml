<local:Popover x:Class="UnixLauncher.Views.NotificationCentre"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UnixLauncher.Views"
        Width="368" SizeToContent="Height" Title="Notification Centre" Foreground="{StaticResource Text}" FontSize="13">
    <!-- macOS 27: no panel. Each notification and widget is its own piece of glass (UI.FloatingGlass); the gaps click through. -->
    <DockPanel Margin="6">
        <!-- Clear all: the round × under the stack -->
        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,10,0,0" Click="ClearAll_Click" ToolTip="Clear All"
                local:UI.GlassRadius="14" Cursor="Hand">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource FloatTint}" BorderBrush="{StaticResource GlassRim}" BorderThickness="1">
                        <TextBlock Text="×" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Calendar widget (built in code: this month, today highlighted) -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource FloatTint}" BorderBrush="{StaticResource GlassRim}" BorderThickness="1" CornerRadius="20" Padding="14,10,14,10" Margin="0,10,0,0"
                local:UI.GlassRadius="20">
            <StackPanel>
                <DockPanel Margin="4,0,0,6">
                    <TextBlock x:Name="DateText" DockPanel.Dock="Right" Foreground="{StaticResource SubText}" FontSize="11"/>
                    <TextBlock x:Name="MonthText" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                </DockPanel>
                <UniformGrid x:Name="DayNames" Columns="7"/>
                <UniformGrid x:Name="Days" Columns="7"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="{StaticResource FloatTint}" BorderBrush="{StaticResource GlassRim}" BorderThickness="1" CornerRadius="16" Padding="14,10" Margin="0,0,0,8"
                local:UI.GlassRadius="16" Visibility="{Binding Visibility, ElementName=StatusText}">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{StaticResource SubText}"/>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Hidden" VerticalAlignment="Top">
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card" Background="{StaticResource FloatTint}" BorderBrush="{StaticResource GlassRim}" BorderThickness="1" CornerRadius="20" Padding="12,10,14,12" Margin="0,0,0,8"
                                local:UI.GlassRadius="20">
                            <Grid>
                                <DockPanel>
                                    <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                    <DockPanel DockPanel.Dock="Top">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Foreground="{StaticResource SubText}" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding App}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Body}" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <!-- macOS shows the dismiss button on hover, at the card's top-left -->
                                <Button x:Name="Close" Content="×" Tag="{Binding}" Click="Dismiss_Click" ToolTip="Clear" Visibility="Hidden"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-18,-16,0,0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Width="20" Height="20" CornerRadius="10" Background="#E0343436" BorderBrush="#40FFFFFF" BorderThickness="0.5">
                                                <TextBlock Text="×" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Close" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</local:Popover>
