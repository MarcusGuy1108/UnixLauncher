<local:Popover x:Class="UnixLauncher.Views.Spotlight"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UnixLauncher.Views"
        Width="676" SizeToContent="Height" Title="Spotlight" Foreground="{StaticResource Text}">
    <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="10">
        <StackPanel>
            <DockPanel Margin="6,2">
                <ContentControl x:Name="SearchIcon" DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <Grid>
                    <TextBlock x:Name="Placeholder" Text="Spotlight Search" FontSize="22" Foreground="{StaticResource SubText}" Margin="2,0,0,0" IsHitTestVisible="False"/>
                    <TextBox x:Name="Query" Style="{StaticResource SearchBox}" FontSize="22" TextChanged="Query_Changed" PreviewKeyDown="Query_Keys"/>
                </Grid>
            </DockPanel>
            <ListBox x:Name="Results" Background="Transparent" BorderThickness="0" Margin="0,8,0,0" Visibility="Collapsed"
                     ItemContainerStyle="{StaticResource ResultItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewMouseLeftButtonUp="Results_Click">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,10,0"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Subtitle}" Opacity="0.6" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Border>
</local:Popover>
