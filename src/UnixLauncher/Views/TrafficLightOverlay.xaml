<Window x:Class="UnixLauncher.Views.TrafficLightOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" ResizeMode="NoResize"
        Width="80" Height="28" Title="Window Controls">
    <!-- Near-transparent background: the whole strip takes the mouse (dragging it moves the window) -->
    <Grid x:Name="Root" Background="#01000000">
        <!-- Ordinary title bars: filled with the title bar's colour so the app's icon and title start don't show through -->
        <Border x:Name="Backing"/>
        <!-- Pointing here: a rounded glass pill fades in behind the buttons -->
        <Border x:Name="Pill" Margin="2" CornerRadius="12" Background="#E62C2C2E" BorderBrush="#33FFFFFF" BorderThickness="0.5" Opacity="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.35"/>
            </Border.Effect>
        </Border>
        <!-- Background must be non-null so the gaps between dots still count as "hovering the group" -->
        <StackPanel x:Name="Dots" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0"
                    Background="#01000000" Height="20">
            <Button Style="{StaticResource TrafficLight}" Background="#FF5F57" Content="×" ToolTip="Close" Click="Close_Click"/>
            <Button x:Name="MinBtn" Style="{StaticResource TrafficLight}" Background="#FEBC2E" Content="−" ToolTip="Minimise" Click="Min_Click"/>
            <Button x:Name="ZoomBtn" Style="{StaticResource TrafficLight}" Background="#28C840" Content="+" ToolTip="Zoom" Click="Zoom_Click"/>
        </StackPanel>
    </Grid>
</Window>
