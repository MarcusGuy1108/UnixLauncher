<Window x:Class="UnixLauncher.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" ResizeMode="NoResize"
        AllowDrop="True" FontFamily="{DynamicResource UiFont}" Title="Dock" Width="800" Height="120">
    <!-- Fully transparent pixels are click-through, so only the shelf and icons take the mouse. -->
    <Grid x:Name="Root">
        <Grid x:Name="Shelf" MouseRightButtonUp="Shelf_RightClick">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="Slide"/>
            </Grid.RenderTransform>
            <Border x:Name="ShelfBg" Background="#C8242426" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18"/>
            <StackPanel x:Name="Items"/>
        </Grid>
    </Grid>
</Window>
